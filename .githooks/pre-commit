#!/usr/bin/env bash
#
# Refuse a commit that would put a credential into this repository.
#
# This is the control, rather than one of the layers on top of it. The Claude
# Code write guard now alongside it (`scripts/claude_code_guard.py`) covers one
# agent in one checkout; this covers commits made by every human and every
# agent, including agents that have never heard of Claude Code. Which is the
# order they were built in on purpose, not an accident of scheduling.
#
# What it sees and what it does not. Each of these is a test in
# `scripts/test_commit_guard.py`, which plants a credential past this hook with
# `--no-verify` and then asks whether the operation below carries it or refuses
# it — so if the coverage ever changes, a test fails and this comment has to
# follow rather than quietly rotting:
#
#   - An ordinary commit, and the commit that finishes a conflicted merge: the
#     hook runs, and reads what that commit adds.
#   - A clean merge, and a rebase: git writes those commits itself and runs no
#     pre-commit hook at all. Tolerable, because the content was read when it
#     was first committed.
#   - An amend: the hook runs, but the staged diff is taken against the commit
#     being replaced, so content already inside that commit is not re-read.
#
# The residue is what the whole-repository sweep is for — a later ticket in
# this set, not something that exists yet. This is the fast layer, and for now
# it is the only one, which is a reason to keep it honest rather than a reason
# to widen it.
#
# It reads the *added lines* of the staged diff, not the staged files. Scanning
# whole files would mean one pre-existing finding anywhere in a file blocks
# every future commit that touches it — including the commit that removes the
# finding. A conflicted merge is where that inverts: everything arriving from
# the other branch reads as added, so a finding already committed over there
# refuses the merge commit. Nothing in this repository trips the detector
# today, so that stays theoretical; if it ever bites, the answer is to mark the
# line, not to bypass the hook.
#
# Latency is the design constraint. A commit is the most latency-sensitive
# moment in the loop, and a hook people wait on is a hook they bypass, so this
# is one `git diff` and one python3 process: no network, no Docker, no
# ecosystem toolchain.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
detector="$repo_root/scripts/credential_detector.py"

# Failing loudly is the right default for a control. A guard that quietly lets
# the commit through when its interpreter is missing is worse than no guard,
# because everyone believes it ran.
if ! command -v python3 >/dev/null 2>&1; then
  echo "Commit refused: the credential guard needs python3, which is not on PATH." >&2
  echo >&2
  echo "python3 ships with macOS and every Linux distribution this project" >&2
  echo "targets. If you genuinely cannot install it, say so on the pull" >&2
  echo "request rather than reaching for --no-verify." >&2
  exit 1
fi

# Invoked through python3 rather than through its shebang, so the guard does
# not also depend on the executable bit surviving every checkout and archive
# this file travels through.
status=0
findings="$(python3 "$detector" --staged 2>&1)" || status=$?

case "$status" in
0)
  exit 0
  ;;
1)
  echo "Commit refused: a staged change carries a credential." >&2
  echo >&2
  echo "$findings" >&2
  exit 1
  ;;
*)
  echo "Commit refused: the credential guard could not run." >&2
  echo >&2
  echo "$findings" >&2
  exit 1
  ;;
esac
