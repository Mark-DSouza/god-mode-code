#!/usr/bin/env bash
#
# Refuse a commit that would put a credential into this repository.
#
# This is the control, rather than one of the layers on top of it. A hook in
# `.claude/settings.json` covers Claude Code sessions in one checkout; this
# covers commits made by every human and every agent, including agents that
# have never heard of Claude Code.
#
# What it does not cover, stated rather than implied: git does not run this
# hook for a merge or a rebase, so content arriving that way is not re-read.
# That is tolerable because it was read when it was first committed — the hole
# is a conflict resolution, where somebody types new content into a commit this
# hook never sees. Nor does it re-read a commit being amended, since the amend
# adds nothing relative to the commit it replaces. The whole-repository sweep
# is what covers all three; this is the fast layer, not the only one.
#
# It reads the *added lines* of the staged diff, not the staged files. Scanning
# whole files would mean one pre-existing finding anywhere in a file blocks
# every future commit that touches it — including the commit that removes the
# finding. (The exception is a merge commit, where everything arriving from the
# other branch reads as added. Nothing in this repository trips the detector
# today, so that stays theoretical; if it ever bites, the answer is to mark the
# line, not to bypass the hook.)
#
# Latency is the design constraint. A commit is the most latency-sensitive
# moment in the loop, and a hook people wait on is a hook they bypass, so this
# is one `git diff` and one python3 process: no network, no Docker, no
# ecosystem toolchain.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
detector="$repo_root/scripts/credential_detector.py"

# Failing loudly is the right default for a control. A guard that quietly lets
# the commit through when its interpreter is missing is worse than no guard,
# because everyone believes it ran.
if ! command -v python3 >/dev/null 2>&1; then
  echo "Commit refused: the credential guard needs python3, which is not on PATH." >&2
  echo >&2
  echo "python3 ships with macOS and every Linux distribution this project" >&2
  echo "targets. If you genuinely cannot install it, say so on the pull" >&2
  echo "request rather than reaching for --no-verify." >&2
  exit 1
fi

# Invoked through python3 rather than through its shebang, so the guard does
# not also depend on the executable bit surviving every checkout and archive
# this file travels through.
status=0
findings="$(python3 "$detector" --staged 2>&1)" || status=$?

case "$status" in
0)
  exit 0
  ;;
1)
  echo "Commit refused: a staged change carries a credential." >&2
  echo >&2
  echo "$findings" >&2
  exit 1
  ;;
*)
  echo "Commit refused: the credential guard could not run." >&2
  echo >&2
  echo "$findings" >&2
  exit 1
  ;;
esac
