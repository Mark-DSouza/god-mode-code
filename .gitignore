# Design bundle archives — superseded by the extracted trees alongside them
mockups-and-design-system/*.zip

# Byte-identical copy of ui_mockups/design_handoff_godmodecode/
mockups-and-design-system/design_system/uploads/god_mode_code_ui_mockups/

# Windows NTFS alternate data streams
*:Zone.Identifier

# Node
node_modules/
*.tsbuildinfo
apps/web/dist/

# Java
target/
!.mvn/wrapper/maven-wrapper.jar

# Go
apps/judge/bin/

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/

# Terraform
#
# The lock file IS committed — it is what pins provider versions across
# machines — but everything below is either local cache, state, or a file
# holding real values for the account this is applied to.
infra/terraform/**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
crash.log
crash.*.log

# Local environment overrides
.env
.env.local
*.local
