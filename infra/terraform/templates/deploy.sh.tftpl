#!/usr/bin/env bash
#
# Deploy. Delivered as a Systems Manager document and invoked by continuous
# integration, so shipping needs no inbound port, no SSH key, and no long-lived
# credential on a runner.
#
# The ordering below is the point of this script and is not incidental: both
# images are pulled while the old container is still serving. A pull can take
# tens of seconds on a burstable instance, so pulling after the stop would turn
# a restart into a download and stretch a ~15 second outage into minutes
# (ADR-0009).
#
# Two conventions worth knowing before editing:
#
#   * Rendered by `templatefile`. A doubled dollar-brace escapes to a literal
#     shell variable; a single one is interpolated by Terraform. That applies
#     inside comments too, which is easy to forget.
#   * Doubled curly braces are Systems Manager document parameters, resolved
#     before this ever reaches a shell. Every one of them must be a parameter
#     the document declares — Systems Manager validates that and rejects the
#     document otherwise, including occurrences inside comments, so this one
#     deliberately describes the syntax rather than writing it out.
#
#     That is also why nothing here uses `docker --format`: Go templates use
#     the same braces. Deployed image references are tracked in marker files
#     instead, which is both simpler and exact, because continuous integration
#     tags every image with an immutable commit SHA.
set -euo pipefail

API_IMAGE="{{ apiImage }}"
WEB_IMAGE="{{ webImage }}"
REGION="${region}"
PREFIX="${parameter_prefix}"

log() { echo "[deploy] $*"; }

get_param() {
  aws ssm get-parameter --region "$REGION" --name "$1" \
    --with-decryption --query 'Parameter.Value' --output text
}

log "Authenticating to the registry"
# Read fresh on every deploy rather than from a copy written at first boot.
# Terraform creates this parameter with a placeholder — its real value is a
# GitHub token written out of band afterwards — so a host that cached it at
# boot would have cached the placeholder and never been able to pull an image
# again. Reading it here also means rotating the token takes effect on the next
# deploy instead of requiring the instance to be rebuilt.
get_param "$PREFIX/registry/token" |
  docker login ${registry} --username oauth2 --password-stdin

# ---------------------------------------------------------------------------
# The journal, which everything else here logs into.
# ---------------------------------------------------------------------------

# Amazon Linux keeps the journal in memory. That loses it on every reboot and,
# more to the point, means /var/log/journal does not exist — so the collector
# would mount an empty directory the container runtime created for it and read
# nothing, quietly (ADR-0008).
#
# This belongs in the bootstrap by the division that file describes: it does not
# change between deploys. It is here anyway, because the bootstrap script is
# `user_data` and `user_data_replace_on_change` means editing it *replaces the
# instance* — a full rebuild, and a site down until the next deploy, to create
# one directory. Running three idempotent commands on every deploy is the
# cheaper of the two mistakes.
#
# Guarded step by step rather than left to `set -e`: this function is called
# from a condition, which disables errexit for everything inside it.
ensure_persistent_journal() {
  # Already persistent. Restarting journald on every deploy would drop a few
  # log lines each time for no reason.
  if [ -d /var/log/journal ]; then
    return 0
  fi

  log "Making the journal persistent"
  install -d -m 2755 /var/log/journal || return 1
  systemd-tmpfiles --create --prefix /var/log/journal || return 1
  # journald only starts writing to disk once it is told to look again.
  systemctl restart systemd-journald || return 1
  # Moves what is already in memory across, so the switch loses nothing.
  journalctl --flush || true
}

if ! ensure_persistent_journal; then
  # Not fatal. A volatile journal still serves `docker logs` and still feeds the
  # collector until the next reboot; refusing to deploy over it would be
  # monitoring taking the site down, which is the trade this whole file avoids.
  log "WARNING: the journal is still volatile; logs will not survive a reboot"
fi

# ---------------------------------------------------------------------------
# Pull everything first. Nothing is stopped until every image is on disk.
# ---------------------------------------------------------------------------

log "Pulling $API_IMAGE"
docker pull "$API_IMAGE"

log "Pulling $WEB_IMAGE"
docker pull "$WEB_IMAGE"

# ---------------------------------------------------------------------------
# The reverse proxy, but only when it actually changed.
# ---------------------------------------------------------------------------

# Caddy serves the SPA and is what keeps the site answering while Spring Boot
# restarts. Replacing it on every backend deploy would throw that away, so it
# is touched only when its image differs — that is, on a frontend change
# (ADR-0009).
DEPLOYED_WEB="$(cat /opt/gmc/web-image 2>/dev/null || true)"
WEB_RUNNING="$(docker ps --quiet --filter name=^/gmc-web$)"

if [ "$DEPLOYED_WEB" != "$WEB_IMAGE" ] || [ -z "$WEB_RUNNING" ]; then
  log "Reverse proxy changed or absent; replacing it"
  docker rm --force gmc-web >/dev/null 2>&1 || true
  docker run --detach \
    --name gmc-web \
    --restart unless-stopped \
    --network gmc \
    --log-driver journald \
    --publish 127.0.0.1:80:80 \
    --env CADDY_PORT=80 \
    --env API_UPSTREAM=api:8080 \
    --env SITE_ROOT=/srv \
    "$WEB_IMAGE"
  printf '%s' "$WEB_IMAGE" >/opt/gmc/web-image
else
  log "Reverse proxy unchanged; leaving it running"
fi

# ---------------------------------------------------------------------------
# The collector.
# ---------------------------------------------------------------------------

# Refreshed before the backend is replaced, so the restart it is about to
# perform is itself observed. Nothing in this section is allowed to fail the
# deploy: monitoring that can take the site down is worse than monitoring that
# is briefly missing.
refresh_collector() {
  install -d -m 0750 /opt/gmc/alloy

  # The configuration is a file in the repository, rendered into this document
  # by Terraform. It arrives with the deploy for the same reason the images do:
  # it changes with the application, and a copy edited on the host is a copy
  # that disagrees with the one everybody reads.
  cat >/opt/gmc/alloy/config.alloy <<'ALLOY_CONFIG'
${alloy_config}
ALLOY_CONFIG

  PROMETHEUS_URL="$(get_param "$PREFIX/observability/prometheus-url" 2>/dev/null || echo unset)"
  PROMETHEUS_USERNAME="$(get_param "$PREFIX/observability/prometheus-username" 2>/dev/null || echo unset)"
  LOKI_URL="$(get_param "$PREFIX/observability/loki-url" 2>/dev/null || echo unset)"
  LOKI_USERNAME="$(get_param "$PREFIX/observability/loki-username" 2>/dev/null || echo unset)"
  GRAFANA_TOKEN="$(get_param "$PREFIX/observability/token" 2>/dev/null || echo unset)"

  # Terraform creates the token with a placeholder and a human writes the real
  # value once. Starting a collector against the placeholder would produce a
  # container that retries an authentication failure forever, which is a worse
  # signal than no collector at all.
  if [ "$GRAFANA_TOKEN" = "placeholder-set-out-of-band" ] || [ "$GRAFANA_TOKEN" = "unset" ] ||
    [ "$PROMETHEUS_URL" = "unset" ] || [ "$LOKI_URL" = "unset" ]; then
    log "Telemetry is not configured; skipping the collector"
    return 0
  fi

  # Replaced only when the configuration or the image changed, so a routine
  # backend deploy does not restart the thing watching it.
  FINGERPRINT="$(sha256sum /opt/gmc/alloy/config.alloy | cut -d' ' -f1)-${collector_image}"
  DEPLOYED="$(cat /opt/gmc/alloy-fingerprint 2>/dev/null || true)"
  RUNNING="$(docker ps --quiet --filter name=^/gmc-alloy$)"

  if [ "$DEPLOYED" = "$FINGERPRINT" ] && [ -n "$RUNNING" ]; then
    log "Collector unchanged; leaving it running"
    return 0
  fi

  # Pulled before anything is removed, and checked explicitly rather than left
  # to `set -e`. Calling a function from a condition disables errexit for
  # everything it goes on to do, so a failed pull here would otherwise fall
  # straight through and tear down a collector that was working perfectly in
  # order to start an image that is not on disk.
  log "Pulling ${collector_image}"
  if ! docker pull "${collector_image}"; then
    log "WARNING: could not pull the collector image; leaving the running one alone"
    return 0
  fi

  log "Starting the collector"
  docker rm --force gmc-alloy >/dev/null 2>&1 || true

  # Three mounts and no container socket. The usual way to collect container
  # logs mounts one, and a collector holding it is root on this host for
  # whoever reaches the collector; both containers log to the journal instead
  # and this reads that. All three are read-only.
  if ! docker run --detach \
    --name gmc-alloy \
    --restart unless-stopped \
    --network gmc \
    --memory 200m \
    --log-driver journald \
    --env GRAFANA_PROMETHEUS_URL="$PROMETHEUS_URL" \
    --env GRAFANA_PROMETHEUS_USERNAME="$PROMETHEUS_USERNAME" \
    --env GRAFANA_LOKI_URL="$LOKI_URL" \
    --env GRAFANA_LOKI_USERNAME="$LOKI_USERNAME" \
    --env GRAFANA_TOKEN="$GRAFANA_TOKEN" \
    --env GMC_ENVIRONMENT="${environment}" \
    --volume /opt/gmc/alloy/config.alloy:/etc/alloy/config.alloy:ro \
    --volume gmc-alloy-data:/var/lib/alloy/data \
    --volume /var/log/journal:/var/log/journal:ro \
    --volume /etc/machine-id:/etc/machine-id:ro \
    --volume /:/host/root:ro,rslave \
    "${collector_image}" \
    run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data; then
    log "WARNING: the collector did not start"
    return 0
  fi

  # Written only once something is actually running. Recording it regardless
  # would make the next deploy believe the collector is current and skip it,
  # turning one failed start into a permanently unobserved host.
  printf '%s' "$FINGERPRINT" >/opt/gmc/alloy-fingerprint
}

if ! refresh_collector; then
  # Loud, and then on with the deploy. This host being unobserved for one
  # release is a problem; refusing to ship because of it is a bigger one.
  log "WARNING: the collector could not be refreshed; continuing without it"
fi

# ---------------------------------------------------------------------------
# The backend.
# ---------------------------------------------------------------------------

DB_URL="$(get_param "$PREFIX/database/url")"
DB_USER="$(get_param "$PREFIX/database/username")"
DB_PASSWORD="$(get_param "$PREFIX/database/password")"
# A fixed private address on the routeless subnet. Terraform pins it, so this
# value survives the judge being replaced and the backend never has to be
# redeployed to find it again (ADR-0005).
JUDGE_URL="$(get_param "$PREFIX/judge/url")"

start_api() {
  docker run --detach \
    --name gmc-api \
    --restart unless-stopped \
    --network gmc \
    --network-alias api \
    --memory 900m \
    --log-driver journald \
    --env DATABASE_URL="$DB_URL" \
    --env DATABASE_USER="$DB_USER" \
    --env DATABASE_PASSWORD="$DB_PASSWORD" \
    --env JUDGE_URL="$JUDGE_URL" \
    --env GMC_VERSION="$1" \
    --env GMC_ENVIRONMENT="${environment}" \
    --env GMC_LOG_FORMAT=ecs \
    "$1"
}

# Recorded before anything is stopped, so a failed deploy can be put back.
PREVIOUS_API="$(cat /opt/gmc/api-image 2>/dev/null || true)"

log "Stopping the running backend"
# SIGTERM, then up to 40 seconds before SIGKILL. Spring Boot drains in-flight
# requests inside its own 30 second shutdown phase, so this window is
# deliberately longer — a shorter one would sever exactly the requests the
# graceful shutdown exists to protect (ADR-0009).
docker stop --time 40 gmc-api >/dev/null 2>&1 || true
docker rm gmc-api >/dev/null 2>&1 || true

log "Starting $API_IMAGE"
start_api "$API_IMAGE"
printf '%s' "$API_IMAGE" >/opt/gmc/api-image

# ---------------------------------------------------------------------------
# Verify, through the proxy.
# ---------------------------------------------------------------------------

# Through Caddy on the loopback interface rather than against the container
# directly, because that is the path real traffic takes. A backend that is
# healthy but unreachable through the proxy is not a successful deploy.
log "Waiting for health"
healthy=false
for _ in $(seq 1 60); do
  if curl --fail --silent --show-error --max-time 3 http://127.0.0.1/api/health >/dev/null 2>&1; then
    healthy=true
    break
  fi
  sleep 2
done

if [ "$healthy" = true ]; then
  log "Healthy. Deploy complete."
  # Reclaims what this deploy replaced. A 20GB root volume fills quietly
  # otherwise, and it does so at the least convenient moment — the next deploy.
  docker image prune --force >/dev/null 2>&1 || true
  exit 0
fi

log "Backend did not become healthy within 120 seconds"

if [ -n "$PREVIOUS_API" ]; then
  log "Rolling back to $PREVIOUS_API"
  docker rm --force gmc-api >/dev/null 2>&1 || true
  start_api "$PREVIOUS_API"
  printf '%s' "$PREVIOUS_API" >/opt/gmc/api-image
fi

# Non-zero, so the Systems Manager command and the workflow that sent it both
# fail visibly. A deploy that quietly restored the previous version is still a
# failed deploy.
exit 1
