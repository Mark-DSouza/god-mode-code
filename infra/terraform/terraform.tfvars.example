# Copy to terraform.tfvars and fill in. The real file is gitignored.
#
# Only account-specific identifiers and secrets appear here. Everything else —
# region, instance sizes, budget limit, backup retention — has a default in
# variables.tf that encodes a decision already made in an ADR, and overriding
# one should be a deliberate act with a reason.

# Cloudflare, from the dashboard: the zone that owns markdsouza.dev, and the
# account that will own the tunnel.
cloudflare_zone_id    = "..."
cloudflare_account_id = "..."

# Token scoped to Zone:DNS:Edit and Account:Cloudflare Tunnel:Edit. Nothing
# wider: this token can create DNS records, and a global key would let a leak
# reconfigure every zone on the account.
#
# Prefer supplying this as TF_VAR_cloudflare_api_token in the environment
# rather than writing it to a file at all.
cloudflare_api_token = "..."

# Where billing alerts go. Somewhere actually read — an alert nobody sees is
# indistinguishable from no alert.
budget_notification_email = "you@example.com"
