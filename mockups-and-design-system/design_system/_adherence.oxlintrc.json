      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypingField'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|typed|size|style|key|ref|className|style|children)$/]",
        "message": "<TypingField> doesn't accept that prop. Declared props: text, typed, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypingField'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<TypingField> size must be one of 'sm' | 'md' | 'lg'."
