      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Wordmark> glow must be one of 'none' | 'sm' | 'md' | 'lg'."
      }
    ]
