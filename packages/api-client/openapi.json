{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "GOD_MODE_CODE API",
    "description" : "Backend for GOD_MODE_CODE.",
    "version" : "0.0.1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin as the application"
  } ],
  "tags" : [ {
    "name" : "Health",
    "description" : "Liveness and dependency status"
  }, {
    "name" : "Users",
    "description" : "Identity, Claimed or otherwise"
  } ],
  "paths" : {
    "/api/users" : {
      "post" : {
        "tags" : [ "Users" ],
        "summary" : "Create an Unclaimed User",
        "description" : "Creates a User with no credentials attached and a generated Handle, and sets the cookie that recognises this browser as them on later visits. Nothing is asked of the visitor.\n\nA browser that already holds a valid cookie is told who it is instead, with 200 — so a retry, a double submit or a second tab cannot strand the Runs the first User already has.\n",
        "operationId" : "create",
        "parameters" : [ {
          "name" : "gmc_user",
          "in" : "cookie",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "201" : {
            "description" : "The Unclaimed User that was created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/User"
                }
              }
            }
          },
          "200" : {
            "description" : "This browser was already someone, and still is",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me" : {
      "get" : {
        "tags" : [ "Users" ],
        "summary" : "Read the User this browser is",
        "description" : "Returns the User the request's cookie identifies. 404 means this browser has never been here, or was here longer ago than the cookie lasts — the caller's cue to create one.\n",
        "operationId" : "me",
        "parameters" : [ {
          "name" : "gmc_user",
          "in" : "cookie",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The User this browser is recognised as",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/User"
                }
              }
            }
          },
          "404" : {
            "description" : "This browser is nobody yet"
          }
        }
      }
    },
    "/api/health" : {
      "get" : {
        "tags" : [ "Health" ],
        "summary" : "Report the backend's status and that of its dependencies",
        "description" : "Returns 200 when every dependency is reachable and 503 when any is not, so an uptime check can rely on the status code alone rather than parsing the body.\n",
        "operationId" : "health",
        "responses" : {
          "200" : {
            "description" : "Every dependency is reachable",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503" : {
            "description" : "At least one dependency is unreachable",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "User" : {
        "type" : "object",
        "description" : "Anyone who has played, whether or not they have Claimed their identity",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Stable identifier",
            "example" : "3f1c0b1a-5c2e-4d3b-9f8a-1e2d3c4b5a69"
          },
          "handle" : {
            "type" : "string",
            "description" : "The User's Handle",
            "example" : "PERCOLATING_FERRET"
          },
          "claimed" : {
            "type" : "boolean",
            "description" : "Whether credentials have been attached to this User",
            "example" : false
          }
        },
        "required" : [ "claimed", "handle", "id" ]
      },
      "HealthStatus" : {
        "type" : "object",
        "description" : "The backend's own status and that of its dependencies",
        "properties" : {
          "status" : {
            "type" : "string",
            "description" : "Overall status",
            "enum" : [ "UP", "DEGRADED" ],
            "example" : "UP"
          },
          "database" : {
            "type" : "string",
            "description" : "PostgreSQL connectivity",
            "enum" : [ "UP", "DEGRADED" ],
            "example" : "UP"
          },
          "version" : {
            "type" : "string",
            "description" : "Running build version",
            "example" : "0.0.1-SNAPSHOT"
          }
        },
        "required" : [ "database", "status", "version" ]
      }
    }
  }
}
